# crm.env — configuración del CRM en el VPS. SOLO NOMBRES, sin valores reales.
# Destino: /etc/chatdental-crm/crm.env (root, chmod 640, propietario root:chatdental).
# Completar los valores en el VPS con un editor (nano/vim), NUNCA en git/chat.
# Sin WHATSAPP_APP_SECRET/VERIFY_TOKEN el webhook responde 403; sin
# WHATSAPP_ACCESS_TOKEN/PHONE_ID el transporte marca 'no_configurado' (no envía
# ni simula). El servicio arranca igual: /health y /ready funcionan.

# --- Base y aplicación (ruta ABSOLUTA, fuera del árbol de código) ---
CRM_DATABASE=/var/lib/chatdental-crm/crm.db
CRM_SECRET_KEY=
CRM_BUSINESS_NAME=
CRM_TIMEZONE=America/Guayaquil
# CRM_ACCENT=

# --- WhatsApp REAL (Cloud API de Meta) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_TIMEOUT_S=30
WHATSAPP_TEMPLATE_IDIOMA=es
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Chat IA interno (proveedor real; sin proveedor: "IA no configurada", nunca simula) ---
# CRM_CHAT_PROVEEDOR=
# CRM_CHAT_PROVEEDOR_API_KEY=
# CRM_CHAT_ENDPOINT=
# CRM_CHAT_MODEL=
# CRM_CHAT_TIMEOUT_S=30
# CRM_CHAT_REINTENTOS=1

# --- Worker (proceso aparte); bucle por defecto si se omiten ---
CRM_MOTOR=
# CRM_WORKER_NAME=
# CRM_WORKER_SLEEP_S=2
# CRM_WORKER_LOOP_S=90
# CRM_WORKER_RECOVER_S=120
# CRM_WORKER_RECOVER_PASADAS=30

# --- Google Calendar (opcional; NO validado en esta entrega) ---
# GOOGLE_APPLICATION_CREDENTIALS=
# CALENDAR_ID=
