# Plantilla de configuración — SOLO NOMBRES, sin valores reales.
# Copiar a .env (privado, nunca en git/chat) y completar los valores localmente.
# La disponibilidad de una variable NO equivale a integración probada: una
# conexión externa sólo se declara verificada con una llamada real autorizada.

OPENROUTER_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=
# Token del bot heredado (FastAPI) para /api/chat y /api/responder (cabecera X-CRM-Token)
CRM_API_TOKEN=
GOOGLE_APPLICATION_CREDENTIALS=
CALENDAR_ID=

# CRM local (crear una clave con: python -c "import secrets; print(secrets.token_hex(32))")
CRM_SECRET_KEY=
CRM_BUSINESS_NAME=Clínica Dental
CRM_TIMEZONE=America/Guayaquil

# --- WhatsApp REAL (Cloud API de Meta, C02) — transporte y webhook actuales ---
# El transporte (crm/transporte_whatsapp.py), el worker (crm/worker.py) y el
# webhook (crm/whatsapp_webhook.py) leen ÚNICAMENTE estas variables WHATSAPP_*.
# WHATSAPP_TOKEN (abajo) es heredada del bot v18 y NO se usa para enviar/recibir.
# Sin WHATSAPP_ACCESS_TOKEN + WHATSAPP_PHONE_ID el transporte responde
# 'no_configurado': NO envía nada ni lo simula (indisponibilidad honesta).
# Un 200 de Meta con wamid es ACEPTACIÓN, no entrega: delivered/read/failed
# llegan después por webhook (value.statuses[]) — aceptado ≠ entregado ≠ leído.
WHATSAPP_ACCESS_TOKEN=      # token del sistema Meta (Bearer) para enviar
WHATSAPP_PHONE_ID=          # identificador del número emisor (phone-number-id; NO es el número visible ni el WABA ID)
WHATSAPP_GRAPH_VERSION=v21.0  # versión admitida por Meta; por defecto v21.0
WHATSAPP_TIMEOUT_S=30       # timeout de red efectivo del POST (segundos)
WHATSAPP_TEMPLATE_IDIOMA=es # idioma por defecto de plantillas explícitas
WHATSAPP_VERIFY_TOKEN=      # token de verificación del webhook (GET hub.challenge; se elige localmente y DEBE coincidir con el campo en Meta)
WHATSAPP_APP_SECRET=        # secreto de la APP de Meta (firma X-Hub-Signature-256 de los POST; NO es el token de acceso)
# Fuera de la ventana de 24 h desde el último inbound, Meta sólo acepta una
# PLANTILLA APROBADA elegida explícitamente en la tarea; la aprobación la
# confirma Meta, nunca se inventa ni aquí ni en la interfaz.
# WHATSAPP_TOKEN=           # heredada del bot anterior (tools/whatsapp.py, Graph v18): el transporte actual NO la lee

# --- Chat de IA interno (C02 paso C) — proveedor real (nunca desde el navegador) ---
# Proveedor previsto: 'abacus' (RouteLLM, OpenAI-compatible, endpoint por defecto
# https://routellm.abacus.ai/v1). Cualquier otro valor de CRM_CHAT_PROVEEDOR
# ('openai-compatible', 'openai', 'anthropic', 'remoto') exige CRM_CHAT_ENDPOINT
# EXPLÍCITO. Sin CRM_CHAT_PROVEEDOR el chat usa el adaptador simulado SOLO para
# desarrollo/pruebas; en producción declarar siempre el proveedor: sin
# credenciales el modo operativo responde «IA no configurada» y no simula.
# Disponibilidad de claves ≠ adaptador configurado ≠ conexión verificada.
# Ninguna cuota o gratuidad de un proveedor se ofrece como garantía.
# CRM_CHAT_PROVEEDOR=abacus
# CRM_CHAT_PROVEEDOR_API_KEY=   (clave secreta del proveedor; sólo en servidor)
# CRM_CHAT_ENDPOINT=            (obligatorio para proveedores distintos de 'abacus'; base OpenAI-compatible)
# CRM_CHAT_MODEL=               (opcional; nombre/alias del modelo)
# CRM_CHAT_TIMEOUT_S=30         (timeout de red efectivo en segundos)
# CRM_CHAT_REINTENTOS=1         (reintentos limitados, sólo seguro: red/timeout/5xx; por defecto 1)

# --- Worker del canal WhatsApp (proceso aparte: python -m crm.worker) ---
# El worker es un proceso INDEPENDIENTE del servidor web y carga el mismo .env.
# CRM_DATABASE debe ser IGUAL para web y worker; para pruebas, apuntar SIEMPRE
# a una base temporal propia, nunca a la base operativa del negocio.
CRM_DATABASE=                # ruta de la base (por defecto analitica.db en la raíz)
CRM_MOTOR=                   # 'simulado' SÓLO desarrollo/pruebas explícitas; vacío = motor real (sin proveedor deriva a humano, nunca simula)
# CRM_WORKER_NAME=worker-whatsapp
# CRM_WORKER_SLEEP_S=2        # pausa entre ciclos (segundos)
# CRM_WORKER_LOOP_S=90        # ventana de reclamo de operaciones (segundos)
# CRM_WORKER_RECOVER_S=120    # antigüedad para rescate de envíos colgados (segundos)
# CRM_WORKER_RECOVER_PASADAS=30  # cada cuántos ciclos se rescata
# CRM_WORKER_LOG=             # ruta opcional del archivo de registro

# Opcional: ruta absoluta; por defecto analitica.db en la raíz del proyecto
# Varias cuentas: cada variable apunta a un JSON local de cuenta de servicio
GOOGLE_CREDS_CENTRO=
GOOGLE_CREDS_NORTE=
